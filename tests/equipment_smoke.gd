extends SceneTree
const Hub = preload("res://scripts/hub.gd")
const Gear = preload("res://scripts/equipment.gd")
const Progression = preload("res://scripts/progression.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var path := "user://gear-test-%d.json" % Time.get_ticks_usec()
	var file := FileAccess.open(path,FileAccess.WRITE)
	file.store_string(JSON.stringify({"version":3,"materials":55,"keys":2,"inventory":{"bow":3,"charm":2},"equipped":{"weapon":"bow","charm":"charm"}})); file.close()
	var h = Hub.new(true,path)
	assert(h.inventory[h.equipped["weapon"]]["level"] == 3 and h.item_type(h.equipped["necklace"]) == "charm")
	assert(h.legacy_data["materials"] == 55)
	for kind in ["vest","boots","hood","pants","ring","bracelet"]:
		var uid: String = h.find_equipment(kind,2)
		assert(h.equip_item(uid))
	assert(h.equipped.size() == 8)
	var stats: Dictionary = h.loadout_stats()
	assert(stats["health"] > 0 and stats["movement"] == 0 and stats["xp"] == 0 and stats["critical_damage"] > 0 and stats["reduction"] > 0 and stats["damage"] > 1)
	var p = Progression.new(); p.apply_loadout(stats)
	assert(p.max_health() > 6 and p.damage() > 1)
	assert(h.unequip("armor") and not h.unequip("weapon"))
	h.save(); var loaded = Hub.new(true,path)
	assert(loaded.inventory == h.inventory and loaded.equipped == h.equipped)
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	var room = load("res://scenes/room.tscn").instantiate(); root.add_child(room)
	room.hub = Hub.new(false)
	var crossbow: String = room.hub.find_equipment("crossbow")
	room.hub.equip_item(crossbow); room.start_game()
	assert(room.combat.progression.weapon == "crossbow" and room.combat.progression.damage() == 2)
	room.hub.parts["weapon"] = 5; assert(room.hub.upgrade(crossbow))
	assert(room.combat.progression.damage() == 2,"Current-run loadout stays immutable")
	room._return_to_hub(); room.start_game()
	assert(room.combat.progression.damage() == 3)
	print("PASS: instance migration, eight equipped slots, rarity stats, level parts, save/reload, immutable run loadout")
	room.queue_free(); quit(0)
