extends SceneTree
const Hub = preload("res://scripts/hub.gd")
const Gear = preload("res://scripts/equipment.gd")
const Progression = preload("res://scripts/progression.gd")

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var path := "user://gear-test-%d.json" % Time.get_ticks_usec()
	# A legacy save gains a starter weapon without losing its existing resources.
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify({"keys": 2, "seals": 1, "training": 2}))
	file.close()
	var hub = Hub.new(true, path)
	assert(hub.keys == 2 and hub.seals == 1 and hub.training == 2)
	assert(hub.inventory == {"bow": 1} and hub.equipped["weapon"] == "bow")
	assert(not hub.craft("crossbow") and not hub.upgrade("bow"))
	hub.grant_materials(50)
	assert(hub.craft("crossbow") and hub.materials == 42)
	assert(not hub.craft("crossbow"), "Crafting cannot overwrite or duplicate an owned item")
	assert(hub.equip_item("crossbow") and not hub.unequip("weapon"))
	assert(hub.upgrade("crossbow") and hub.inventory["crossbow"] == 2 and hub.materials == 39)
	assert(hub.craft("vest") and hub.equip_item("vest"))
	assert(hub.craft("boots") and hub.equip_item("boots"))
	assert(hub.craft("charm") and hub.equip_item("charm"))
	var stats: Dictionary = hub.loadout_stats()
	assert(stats["damage"] == 3 and stats["pierce"] == 1 and stats["health"] == 2)
	assert(stats["movement"] > 0 and stats["xp"] > 0)
	var p = Progression.new()
	p.base_health += hub.training
	p.apply_loadout(stats)
	assert(p.max_health() == 10 and p.damage() == 3 and p.base_pierce == 1)
	assert(p.movement_multiplier() > 1 and p.xp_multiplier() > 1)
	var reloaded = Hub.new(true, path)
	assert(reloaded.inventory == hub.inventory and reloaded.equipped == hub.equipped and reloaded.materials == hub.materials)
	assert(reloaded.unequip("armor") and reloaded.loadout_stats()["health"] == 0)
	var before: int = hub.materials
	hub.find_equipment("vest")
	assert(hub.inventory["vest"] == 1 and hub.materials == before + 2)
	hub.find_equipment("wand")
	assert(hub.inventory["wand"] == 1)
	hub.grant_materials(100)
	while hub.inventory["bow"] < Gear.MAX_LEVEL: assert(hub.upgrade("bow"))
	before = hub.materials
	assert(not hub.upgrade("bow") and hub.materials == before)
	# Unknown gear, wrong slots and invalid levels must not corrupt the loadout.
	file = FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify({"inventory": {"bogus": 99, "wand": -4, "vest": 99}, "equipped": {"weapon": "vest", "armor": "bogus"}}))
	file.close()
	reloaded = Hub.new(true, path)
	assert(reloaded.equipped["weapon"] == "bow" and reloaded.inventory["vest"] == 5 and not reloaded.inventory.has("bogus"))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	# Snapshot equipment into a run; changing the stash cannot change active stats.
	var room = load("res://scenes/room.tscn").instantiate()
	root.add_child(room)
	room.hub = Hub.new(false)
	room.hub.materials = 100
	room.hub.craft("crossbow")
	room.hub.equip_item("crossbow")
	room.start_game()
	assert(room.combat.progression.weapon == "crossbow" and room.combat.progression.damage() == 2)
	room.hub.upgrade("crossbow")
	assert(room.combat.progression.damage() == 2, "Run loadout is immutable until a new run")
	room._armory_equip("bow")
	assert(room.hub.equipped["weapon"] == "crossbow", "Equipment UI cannot change the loadout during a run")
	room._return_to_hub()
	room.start_game()
	assert(room.combat.progression.damage() == 3)
	print("PASS: legacy migration, stash validation, crafting, upgrade costs/caps, slot equip, armor/boots/charm, duplicates, save/reload, loadout snapshots")
	room.queue_free()
	quit(0)
