extends SceneTree
const Hub = preload("res://scripts/hub.gd")
const Menu = preload("res://scripts/hub_menu.gd")
var departures := 0
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var h = Hub.new(false)
	h.record_floor(9); assert(not h.pet_slot_unlocked())
	h.record_floor(10); h.record_floor(3); assert(h.pet_slot_unlocked() and h.highest_floor == 10)
	var menu = Menu.new(); root.add_child(menu); menu.setup(h)
	assert(menu.TABS == ["Shop","Inventory","Play","Perks","Miscellaneous"])
	assert(menu.slot_buttons.size() == 8 and menu.future_buttons.size() == 2)
	for slot in menu.LEFT_SLOTS: assert(menu.slot_buttons[slot].position.x < 240)
	for slot in menu.RIGHT_SLOTS: assert(menu.slot_buttons[slot].position.x > 240)
	assert(menu.future_buttons["pet"].disabled and menu.future_buttons["spirit"].disabled)
	menu.select_tab(1); assert(menu.inventory_grid.get_child_count() == h.inventory.size())
	menu._toggle_synthesis(); assert(menu.synthesis_mode and menu.synthesis_top.visible)
	for button in menu.slot_buttons.values(): assert(not button.visible)
	var base: String = h.equipped["weapon"]
	h.find_equipment("wand")
	for i in range(3): h.find_equipment("bow")
	menu._item_clicked(base)
	await process_frame
	assert(menu.inventory_grid.get_child_count() == 3, "Only valid ingredients are visible")
	for button in menu.inventory_grid.get_children(): assert(not button.disabled)
	menu._clear_synthesis()
	menu._quick_synthesis()
	assert(h.inventory[base]["rarity"] == 1)
	menu._toggle_synthesis(); menu.dungeon_requested.connect(func(): departures += 1)
	menu.select_tab(2); assert(departures == 0)
	menu.dungeon_button.pressed.emit(); assert(departures == 1)
	await process_frame
	assert(menu.perk_grid.get_child_count() == 12)
	assert(menu.task_buttons.size()==4)
	for button in menu.task_buttons: assert(button.visible)
	menu.queue_free()
	var room = load("res://scenes/room.tscn").instantiate(); root.add_child(room)
	room.hub = Hub.new(false)
	room.hub.perks.merge({"starting_upgrade":1,"starting_hp":3,"dodge":4,"boss_damage":5},true)
	room._refresh_hub()
	room.hub.perks["resourceful"] = 1; room._refresh_hub(); room.hub_menu.select_tab(3)
	room.hub_menu.perk_info_requested.emit("resourceful")
	assert(not room.service_panel.visible and room.hub_menu.perk_page.preview.visible)
	assert(room.hub_menu.perk_page.preview_effect.text=="Dungeon shop prices −0.5%")
	room._close_service(); room.start_game()
	assert(room.combat.progression.base_health == 9)
	assert(is_equal_approx(room.combat.progression.dodge_chance,0.04))
	assert(is_equal_approx(room.combat.progression.boss_damage_bonus,0.1))
	assert(room.combat.progression.pending == 1)
	assert(room.combat.progression.offers.size() == 2)
	assert(room.active and not room.hub_menu.visible)
	room._return_to_hub(); assert(room.in_hub and room.hub_menu.visible)
	print("PASS: eight-slot layout, reserved slots, synthesis screen, 12 perk cards, reserved tasks, navigation/departure/hub return")
	room.queue_free(); quit(0)
