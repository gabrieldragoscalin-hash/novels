extends SceneTree
const Hub = preload("res://scripts/hub.gd")
const Gear = preload("res://scripts/equipment.gd")
const Menu = preload("res://scripts/hub_menu.gd")
var departures := 0

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	var path := "user://hub-layout-%d.json" % Time.get_ticks_usec()
	var file := FileAccess.open(path, FileAccess.WRITE)
	file.store_string(JSON.stringify({"version":2,"keys":3,"materials":50,"training":2,"inventory":{"bow":3,"charm":4},"equipped":{"weapon":"bow","charm":"charm"}}))
	file.close()
	var h = Hub.new(true, path)
	assert(h.keys == 3 and h.training == 2 and h.equipped["necklace"] == "charm" and h.inventory["charm"] == 4)
	assert(h.equipped.size() == 8 and Gear.SLOTS == ["weapon","armor","headgear","pants","boots","necklace","ring","bracelet"])
	for id in ["hood","pants","ring","bracelet"]:
		assert(h.craft(id) and h.equip_item(id))
	assert(h.loadout_stats()["critical"] > 0 and h.loadout_stats()["interval"] < Gear.stats("bow",3)["interval"])
	h.record_floor(9)
	assert(not h.pet_slot_unlocked())
	h.record_floor(10)
	h.record_floor(3)
	assert(h.highest_floor == 10 and h.pet_slot_unlocked())
	var again = Hub.new(true,path)
	assert(again.equipped == h.equipped and again.highest_floor == 10 and again.pet_slot_unlocked())
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	var menu = Menu.new()
	root.add_child(menu)
	menu.setup(h)
	assert(menu.TABS == ["Shop","Inventory","Play","Perks","Miscellaneous"])
	assert(menu.selected == 2 and menu.pages[2].visible)
	assert(menu.slot_buttons.size() == 8 and menu.future_buttons.size() == 2)
	for slot in menu.LEFT_SLOTS: assert(menu.slot_buttons[slot].position.x < 240)
	for slot in menu.RIGHT_SLOTS: assert(menu.slot_buttons[slot].position.x > 240)
	assert(menu.future_buttons["pet"].position.y > menu.slot_buttons["pants"].position.y)
	assert(menu.future_buttons["pet"].disabled and menu.future_buttons["spirit"].disabled)
	menu.dungeon_requested.connect(func(): departures += 1)
	menu.select_tab(1)
	assert(menu.pages[1].visible and not menu.pages[2].visible and departures == 0)
	assert(menu.inventory_grid.get_child_count() == h.inventory.size())
	menu.select_tab(2)
	assert(departures == 0, "Play tab selects the page; the dungeon icon starts the run")
	menu.dungeon_button.pressed.emit()
	assert(departures == 1)
	menu.queue_free()
	var room = load("res://scenes/room.tscn").instantiate()
	root.add_child(room)
	room.hub = Hub.new(false)
	room._refresh_hub()
	assert(room.in_hub and room.hub_menu.visible)
	room.hub_menu.dungeon_button.pressed.emit()
	assert(room.active and not room.in_hub and not room.hub_menu.visible)
	room._return_to_hub()
	assert(not room.active and room.in_hub and room.hub_menu.visible and room.hub_menu.selected == 2)
	print("PASS: eight slots, four per side, charm migration, new gear, pet milestone persistence, Spirit locked, tab order, icon-only departure, hub return")
	room.queue_free()
	quit(0)
