extends SceneTree
const Art = preload("res://scripts/game_art.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	Art.prepare()
	assert(Art.frames.size()==16)
	for key in Art.ACTOR_KEYS+Art.PROP_KEYS:
		var texture := Art.frame(key)
		assert(texture.get_width()>20 and texture.get_height()>20)
		assert(Rect2(Vector2.ZERO,texture.atlas.get_size()).encloses(texture.region))
		assert(texture.filter_clip and texture==Art.frame(key))
	assert(Art.ACTORS.get_image().detect_alpha()!=Image.ALPHA_NONE)
	assert(Art.PROPS.get_image().detect_alpha()!=Image.ALPHA_NONE)
	assert(Art.CORRUPTION.get_image().get_pixel(600,600).a==0)
	assert(Art.stage(1)==0 and Art.stage(10)==1 and Art.stage(5)>0)
	assert(Art.region(10)["name"]=="The Fallen Sanctuary" and Art.region(11)["name"]=="The Crimson Court")
	assert(not Art.region(50)["production"] and not Art.region(100)["production"])
	var game = load("res://scenes/room.tscn").instantiate(); root.add_child(game)
	game.hub = preload("res://scripts/hub.gd").new(false)
	game.start_game()
	assert(game.FLOOR==Rect2(8,166,464,438) and game.PILLARS.size()>=2 and game.PILLARS==game.combat.obstacles)
	assert(game.combat.progression.damage()==1 and game.combat.progression.max_health()==6)
	game.queue_free()
	print("PASS: 16 alpha atlas frames/cache, clear overlay center, gradual sanctuary stage, future-region catalog and room-specific collision and preserved stats")
	quit(0)
