extends SceneTree
## Analyze alpha to generate atlas UV metadata; never modifies source artwork.
func _initialize() -> void:
	var groups := {
		"actors":["hero_front","hero_back","normal","shooter","brute","boss","miniboss","merchant"],
		"props":["pillar","chest_closed","chest_open","shop","healer","upgrade","wheel","exit"]
	}
	var frames := {}
	var pivots := {}
	for group in groups:
		var source := Image.load_from_file("res://art/sanctuary/%s.png" % group)
		assert(source!=null)
		source.convert(Image.FORMAT_RGBA8)
		var data := source.get_data()
		for index in range(8):
			var x0 := int(floor((index%4)*source.get_width()/4.0))
			var y0 := int(floor(int(index/4)*source.get_height()/2.0))
			var x1 := int(floor((index%4+1)*source.get_width()/4.0))
			var y1 := int(floor((int(index/4)+1)*source.get_height()/2.0))
			var left := x1; var top := y1; var right := x0; var bottom := y0
			for y in range(y0,y1):
				for x in range(x0,x1):
					if data[(y*source.get_width()+x)*4+3]<32: continue
					left = mini(left,x); right = maxi(right,x)
					top = mini(top,y); bottom = maxi(bottom,y)
			assert(right>=left and bottom>=top)
			# Two source pixels preserve soft anti-aliased silhouettes without adjacent cells.
			left = maxi(x0,left-2); top = maxi(y0,top-2)
			right = mini(x1-1,right+2); bottom = mini(y1-1,bottom+2)
			var key: String = groups[group][index]
			frames[key] = [left,top,right-left+1,bottom-top+1]
			var weighted_x := 0.0; var alpha_sum := 0.0
			if group=="actors":
				for y in range(maxi(top,bottom-int((bottom-top+1)*0.06)),bottom+1):
					for x in range(left,right+1):
						var alpha: int = data[(y*source.get_width()+x)*4+3]
						if alpha<128: continue
						weighted_x += x*alpha; alpha_sum += alpha
			pivots[key] = (weighted_x/alpha_sum-left)/(right-left+1) if alpha_sum>0 else 0.5
	var file := FileAccess.open("res://scripts/art_regions.gd",FileAccess.WRITE)
	assert(file!=null)
	file.store_string("extends RefCounted\n# Generated by tools/build_art_regions.gd from alpha >=32. Source PNGs untouched.\nconst FRAMES := "+var_to_str(frames)+"\nconst PIVOTS := "+var_to_str(pivots)+"\n")
	file.close()
	print("Generated 16 tight atlas regions: "+JSON.stringify(frames))
	quit(0)
